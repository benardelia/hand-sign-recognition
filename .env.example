# Application Settings
PORT=5001

# Security & Domain Settings (for production SSL / reverse proxy)
DOMAIN_NAME=handsign.duckdns.org

# Access tokens (recommended for public deployments). When set, clients must send
# the X-Handsign-Token header; the web UI asks for it once and remembers it.
#   ADMIN_TOKEN   protects training and deleting data
#   COLLECT_TOKEN protects uploading new samples (leave empty for open collection)
ADMIN_TOKEN=
COLLECT_TOKEN=

# Default quality profile for the server (low | high | experimental), see config/profiles.json
PROFILE=high

# 1 = use this machine's own webcam (needs requirements-local.txt). Keep 0 on servers.
LOCAL_CAMERA=0
